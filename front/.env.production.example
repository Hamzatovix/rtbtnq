NODE_ENV=production
DATABASE_URL="file:./prisma_data/prod.db"

# JWT Secret - ОБЯЗАТЕЛЬНО замени на свой длинный случайный ключ!
JWT_SECRET=your_long_random_jwt_secret_here
ADMIN_USERNAME=your_admin_username
# ADMIN_PASSWORD_HASH - сгенерируй через: node -e "console.log(require('bcryptjs').hashSync('ТВОЙ_ПАРОЛЬ', 10))"
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# Telegram уведомления
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Web Push уведомления в backoffice (в т.ч. на телефон, см. кнопку-колокольчик)
# Сгенерировать пару: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@rosebotanique.store

# Публичный URL сайта
NEXT_PUBLIC_BASE_URL=https://rosebotanique.store

# Supabase (опционально, если не используешь - оставь пустым)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (опционально, если не используешь - оставь пустым)
BLOB_READ_WRITE_TOKEN=
